# ---------------------------------------------------------------------------
# ServicePulse AI — environment variables (server-side only; never exposed to the browser)
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------

# Postgres connection string.
#  - Supabase: Project Settings → Database → Connection string.
#    Use the transaction pooler (port 6543) on Vercel, e.g.
#    postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#  - Local (no Docker needed): `npm run db:local` then use the URL below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Max pooled connections (default 5 in production, 8 in development).
# Set to 1 when using the local PGlite server (npm run db:local), which is single-connection.
DATABASE_POOL_MAX=1

# Set to true for Supabase / any hosted Postgres that requires TLS.
DATABASE_SSL=false

# Anthropic API key (console.anthropic.com). Optional: without it ServicePulse uses its deterministic
# rule-based fallback for classification, root cause and team recommendation
# (clearly labelled "Rules" in the UI and audit log).
ANTHROPIC_API_KEY=

# Model for bulk complaint classification (fast, low cost).
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Model for root-cause analysis, team recommendation and Ask ServicePulse.
ANTHROPIC_MODEL_DEEP=claude-opus-5-5

# Alternative AI provider: Google Gemini (free tier key from aistudio.google.com). Used only when
# ANTHROPIC_API_KEY is empty. Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_DEEP=gemini-flash-latest

# Per-request AI timeout in milliseconds (1 automatic retry). Keep well under the 60s route limit.
AI_TIMEOUT_MS=25000

# Length of the trend comparison period in days (current vs previous period).
ANALYSIS_PERIOD_DAYS=7
